{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TrustOnlyPhase6AgentCoreRuntime",
      "Effect": "Allow",
      "Principal": {
        "Service": "bedrock-agentcore.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "<AWS_ACCOUNT_ID>"
        },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:bedrock-agentcore:<AWS_REGION>:<AWS_ACCOUNT_ID>:runtime/*mr_lister_phase6-*"
        }
      }
    }
  ]
}
