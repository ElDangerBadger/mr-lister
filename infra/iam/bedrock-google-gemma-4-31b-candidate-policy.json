{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EvaluateOnlyGemma431BInUSWest2",
      "Effect": "Allow",
      "Action": "bedrock-mantle:CreateInference",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
