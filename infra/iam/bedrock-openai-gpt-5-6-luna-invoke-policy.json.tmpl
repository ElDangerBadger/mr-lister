{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeOpenAIGPT56LunaUSProfile",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": "arn:aws:bedrock:us-west-2:<AWS_ACCOUNT_ID>:inference-profile/us.openai.gpt-5.6-luna"
    },
    {
      "Sid": "InvokeOpenAIGPT56LunaOnlyThroughUSProfile",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": [
        "arn:aws:bedrock:us-east-1::foundation-model/openai.gpt-5.6-luna",
        "arn:aws:bedrock:us-east-2::foundation-model/openai.gpt-5.6-luna",
        "arn:aws:bedrock:us-west-2::foundation-model/openai.gpt-5.6-luna"
      ],
      "Condition": {
        "StringEquals": {
          "bedrock:InferenceProfileArn": "arn:aws:bedrock:us-west-2:<AWS_ACCOUNT_ID>:inference-profile/us.openai.gpt-5.6-luna"
        }
      }
    },
    {
      "Sid": "InvokeOpenAIDefaultProject",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": "arn:aws:bedrock:us-west-2:<AWS_ACCOUNT_ID>:project/default"
    }
  ]
}
