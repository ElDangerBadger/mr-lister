    "PublicationRequestRegistered": {"Value": "false"},
    "PublicationWorkerTriggered": {"Value": "false"},
    "SellerPublicationEnabled": {"Value": "false"},
    "ProviderMutationEnabled": {"Value": "false"}
  }
