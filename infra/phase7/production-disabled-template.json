          {"Id": "dlq", "MetricStat": {"Metric": {"Namespace": "AWS/Events", "MetricName": "InvocationsFailedToBeSentToDlq", "Dimensions": [{"Name": "RuleName", "Value": {"Ref": "PublicationWorkflowFailureRule"}}]}, "Period": 300, "Stat": "Sum"}, "ReturnData": false}
