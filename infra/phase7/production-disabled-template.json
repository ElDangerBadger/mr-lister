{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Transform": "AWS::Serverless-2016-10-31",
  "Description": "Phase 7.15C production-disabled candidate topology; deployable only with every invocation and publication barrier closed",
  "Parameters": {
    "ActivationMode": {
      "Type": "String",
      "Default": "SOURCE_ONLY_DISABLED",
      "AllowedValues": ["SOURCE_ONLY_DISABLED", "PRODUCTION_DISABLED"]
    },
    "EnvironmentName": {
      "Type": "String",
      "Default": "dev",
      "AllowedPattern": "^[a-z][a-z0-9-]{1,15}$"
    },
    "CandidateCodeS3Bucket": {
      "Type": "String",
      "AllowedPattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
    },
    "CandidateReleaseFingerprint": {
      "Type": "String",
      "AllowedPattern": "^(?!0{64}$)[a-f0-9]{64}$"
    },
    "CandidateCodeS3ObjectVersion": {
      "Type": "String",
      "AllowedPattern": "^(?!null$)[A-Za-z0-9._+=/-]{1,1024}$"
    },
    "StateTableArn": {
      "Type": "String",
      "AllowedPattern": "^arn:[a-z0-9-]+:dynamodb:[a-z0-9-]+:[0-9]{12}:table/mr-lister-phase6-[a-z][a-z0-9-]{1,15}$"
    },
    "StateTableStreamArn": {
      "Type": "String",
      "AllowedPattern": "^arn:[a-z0-9-]+:dynamodb:[a-z0-9-]+:[0-9]{12}:table/mr-lister-phase6-[a-z][a-z0-9-]{1,15}/stream/.+$"
    },
    "SellerUserPoolId": {
      "Type": "String",
      "AllowedPattern": "^[a-z0-9-]+_[A-Za-z0-9]{1,64}$"
    },
    "SellerUserPoolClientId": {
      "Type": "String",
      "AllowedPattern": "^[A-Za-z0-9]{1,128}$"
    }
  },
  "Conditions": {
    "InstantiateProductionCandidate": {
      "Fn::Equals": [
        {"Ref": "ActivationMode"},
        "PRODUCTION_DISABLED"
      ]
    }
  },
  "Globals": {
    "Function": {
      "Runtime": "python3.12",
      "Architectures": ["arm64"],
      "MemorySize": 512,
      "Timeout": 30,
      "ReservedConcurrentExecutions": 0,
      "LoggingConfig": {
        "LogFormat": "JSON",
        "ApplicationLogLevel": "ERROR",
        "SystemLogLevel": "WARN"
      },
      "Environment": {
        "Variables": {
          "MR_LISTER_PHASE7_SCAFFOLD_ONLY": "true",
          "MR_LISTER_PHASE7_QUERY_ENABLED": "false",
          "MR_LISTER_PHASE7_REQUEST_ENABLED": "false",
          "MR_LISTER_PHASE7_PUBLICATION_ENABLED": "false",
          "MR_LISTER_PHASE7_PRODUCTION_CANDIDATE_ENABLED": "false",
          "MR_LISTER_PHASE7_PRODUCTION_RELEASE_FINGERPRINT": {"Ref": "CandidateReleaseFingerprint"},
          "MR_LISTER_RELEASE_FINGERPRINT": {"Ref": "CandidateReleaseFingerprint"},
          "MR_LISTER_PHASE7_CONTRACT_FINGERPRINT": "548b710230618e73c20a509f2121799c415b50070e1e2ae7e1b82fe3c37e2981",
          "MR_LISTER_PHASE7_CONTRACT_VERSION": "7.0.1",
          "MR_LISTER_PHASE7_ACTIVATION_MODE": "SOURCE_ONLY_DISABLED",
          "MR_LISTER_STATE_TABLE": {"Fn::Sub": "mr-lister-phase6-${EnvironmentName}"},
          "MR_LISTER_COGNITO_ISSUER": {"Fn::Sub": "https://cognito-idp.${AWS::Region}.${AWS::URLSuffix}/${SellerUserPoolId}"},
          "MR_LISTER_COGNITO_CLIENT_ID": {"Ref": "SellerUserPoolClientId"},
          "MR_LISTER_COGNITO_SCOPE": "mr-lister-api/seller",
          "MR_LISTER_COGNITO_GROUP": "seller",
          "MR_LISTER_PRODUCT_PROFILE_ID": "gildan_64000_swiftpod",
          "MR_LISTER_PRODUCT_PROFILE_VERSION": "2",
          "MR_LISTER_PRODUCT_PROFILE_FINGERPRINT": "5de1257141cfdacb1731f68bb9113712957483b33d5b0f7115afdba86eb7476c",
          "MR_LISTER_PRODUCT_PROFILE_PATH": "/var/task/config/product_profiles/gildan_64000_swiftpod.json"
        }
      },
      "Tags": {
        "Project": "MrLister",
        "Phase": "7.15C-production-disabled"
      }
    }
  },
  "Resources": {
    "PublicationQueryLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Condition": "InstantiateProductionCandidate",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": {"Fn::Sub": "/aws/lambda/mr-lister-phase7-${EnvironmentName}-publication-query"},
        "RetentionInDays": 14
      }
    },
    "PublicationRequestLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Condition": "InstantiateProductionCandidate",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": {"Fn::Sub": "/aws/lambda/mr-lister-phase7-${EnvironmentName}-publication-request"},
        "RetentionInDays": 14
      }
    },
    "PublicationDispatcherLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Condition": "InstantiateProductionCandidate",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": {"Fn::Sub": "/aws/lambda/mr-lister-phase7-${EnvironmentName}-publication-dispatcher"},
        "RetentionInDays": 14
      }
    },
    "PublicationWorkerLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Condition": "InstantiateProductionCandidate",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": {"Fn::Sub": "/aws/lambda/mr-lister-phase7-${EnvironmentName}-publication-worker"},
        "RetentionInDays": 14
      }
    },
    "PublicationRecoveryLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Condition": "InstantiateProductionCandidate",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": {"Fn::Sub": "/aws/lambda/mr-lister-phase7-${EnvironmentName}-publication-recovery"},
        "RetentionInDays": 14
      }
    },
    "PublicationRetentionLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Condition": "InstantiateProductionCandidate",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": {"Fn::Sub": "/aws/lambda/mr-lister-phase7-${EnvironmentName}-publication-retention"},
        "RetentionInDays": 14
      }
    },
    "PublicationWorkflowLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Condition": "InstantiateProductionCandidate",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "LogGroupName": {"Fn::Sub": "/aws/vendedlogs/states/mr-lister-phase7-${EnvironmentName}-publication"},
        "RetentionInDays": 14
      }
    },
    "PublicationOperationsDeadLetterQueue": {
      "Type": "AWS::SQS::Queue",
      "Condition": "InstantiateProductionCandidate",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "QueueName": {"Fn::Sub": "mr-lister-phase7-${EnvironmentName}-publication-operations-dlq"},
        "MessageRetentionPeriod": 1209600,
        "SqsManagedSseEnabled": true,
        "RedriveAllowPolicy": {
          "redrivePermission": "byQueue",
          "sourceQueueArns": [
            {"Fn::Sub": "arn:${AWS::Partition}:sqs:${AWS::Region}:${AWS::AccountId}:mr-lister-phase7-${EnvironmentName}-publication-recovery"}
          ]
        }
      }
    },
    "PublicationWorkflowRecoveryQueue": {
      "Type": "AWS::SQS::Queue",
      "Condition": "InstantiateProductionCandidate",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "QueueName": {"Fn::Sub": "mr-lister-phase7-${EnvironmentName}-publication-recovery"},
        "MessageRetentionPeriod": 1209600,
        "VisibilityTimeout": 180,
        "SqsManagedSseEnabled": true,
        "RedrivePolicy": {
          "deadLetterTargetArn": {"Fn::GetAtt": ["PublicationOperationsDeadLetterQueue", "Arn"]},
          "maxReceiveCount": 12
        }
      }
    },
    "PublicationAlarmKey": {
      "Type": "AWS::KMS::Key",
      "Condition": "InstantiateProductionCandidate",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "Customer-managed key for Phase 7 publication alarm delivery",
        "EnableKeyRotation": true,
        "KeySpec": "SYMMETRIC_DEFAULT",
        "KeyUsage": "ENCRYPT_DECRYPT",
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "EnableAccountKeyAdministration",
              "Effect": "Allow",
              "Principal": {"AWS": {"Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:root"}},
              "Action": "kms:*",
              "Resource": "*"
            },
            {
              "Sid": "AllowOnlyPhase7PublicationCloudWatchAlarms",
              "Effect": "Allow",
              "Principal": {"Service": "cloudwatch.amazonaws.com"},
              "Action": ["kms:Decrypt", "kms:GenerateDataKey*"],
              "Resource": "*",
              "Condition": {
                "StringEquals": {"aws:SourceAccount": {"Ref": "AWS::AccountId"}},
                "ArnLike": {"aws:SourceArn": {"Fn::Sub": "arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:mr-lister-phase7-${EnvironmentName}-publication-*"}}
              }
            },
            {
              "Sid": "AllowSnsEncryptionForOnlyPhase7PublicationAlarms",
              "Effect": "Allow",
              "Principal": {"Service": "sns.amazonaws.com"},
              "Action": ["kms:Decrypt", "kms:GenerateDataKey*"],
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {"Ref": "AWS::AccountId"},
                  "kms:EncryptionContext:aws:sns:topicArn": {"Fn::Sub": "arn:${AWS::Partition}:sns:${AWS::Region}:${AWS::AccountId}:mr-lister-phase7-${EnvironmentName}-publication-alarms"}
                },
                "ArnLike": {"aws:SourceArn": {"Fn::Sub": "arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:mr-lister-phase7-${EnvironmentName}-publication-*"}}
              }
            }
          ]
        }
      }
    },
    "PublicationAlarmTopic": {
      "Type": "AWS::SNS::Topic",
      "Condition": "InstantiateProductionCandidate",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TopicName": {"Fn::Sub": "mr-lister-phase7-${EnvironmentName}-publication-alarms"},
        "KmsMasterKeyId": {"Fn::GetAtt": ["PublicationAlarmKey", "Arn"]}
      }
    },
    "PublicationAlarmTopicPolicy": {
      "Type": "AWS::SNS::TopicPolicy",
      "Condition": "InstantiateProductionCandidate",
      "Properties": {
        "Topics": [{"Ref": "PublicationAlarmTopic"}],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{
            "Sid": "AllowOnlyPhase7PublicationAlarms",
            "Effect": "Allow",
            "Principal": {"Service": "cloudwatch.amazonaws.com"},
            "Action": "sns:Publish",
            "Resource": {"Ref": "PublicationAlarmTopic"},
            "Condition": {
              "StringEquals": {"aws:SourceAccount": {"Ref": "AWS::AccountId"}},
              "ArnLike": {"aws:SourceArn": {"Fn::Sub": "arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:mr-lister-phase7-${EnvironmentName}-publication-*"}}
            }
          }]
        }
      }
    },
    "PublicationQueryRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "InstantiateProductionCandidate",
      "Properties": {
        "RoleName": {"Fn::Sub": "mr-lister-phase7-${EnvironmentName}-publication-query-role"},
        "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "lambda.amazonaws.com"}, "Action": "sts:AssumeRole"}]},
        "Policies": [{
          "PolicyName": "ReadOnlyPublicationProjection",
          "PolicyDocument": {"Version": "2012-10-17", "Statement": [
            {"Sid": "WriteQueryLogs", "Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": {"Fn::Sub": "${PublicationQueryLogGroup.Arn}:*"}},
            {"Sid": "ReadOwnerPublicationState", "Effect": "Allow", "Action": ["dynamodb:GetItem", "dynamodb:Query"], "Resource": {"Ref": "StateTableArn"}, "Condition": {"ForAllValues:StringLike": {"dynamodb:LeadingKeys": ["JOB#*", "PUBLICATION#*"]}}}
          ]}
        }]
      }
    },
    "PublicationRequestRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "InstantiateProductionCandidate",
      "Properties": {
        "RoleName": {"Fn::Sub": "mr-lister-phase7-${EnvironmentName}-publication-request-role"},
        "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "lambda.amazonaws.com"}, "Action": "sts:AssumeRole"}]},
        "Policies": [{
          "PolicyName": "AtomicPublicationRequest",
          "PolicyDocument": {"Version": "2012-10-17", "Statement": [
            {"Sid": "WriteRequestLogs", "Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": {"Fn::Sub": "${PublicationRequestLogGroup.Arn}:*"}},
            {"Sid": "ReadRequestAuthority", "Effect": "Allow", "Action": ["dynamodb:GetItem"], "Resource": {"Ref": "StateTableArn"}, "Condition": {"ForAllValues:StringLike": {"dynamodb:LeadingKeys": ["JOB#*", "OWNER#*", "PUBLICATION#*"]}}},
            {"Sid": "CommitRequestConditionChecks", "Effect": "Allow", "Action": "dynamodb:ConditionCheckItem", "Resource": {"Ref": "StateTableArn"}, "Condition": {"ForAllValues:StringLike": {"dynamodb:LeadingKeys": ["JOB#*", "OWNER#*", "PUBLICATION#*"]}}},
            {"Sid": "CommitRequestPuts", "Effect": "Allow", "Action": "dynamodb:PutItem", "Resource": {"Ref": "StateTableArn"}, "Condition": {"ForAllValues:StringLike": {"dynamodb:LeadingKeys": ["JOB#*", "OWNER#*", "PUBLICATION#*"]}, "ForAnyValue:StringEquals": {"dynamodb:EnclosingOperation": ["TransactWriteItems"]}}}
          ]}
        }]
      }
    },
    "PublicationDispatcherRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "InstantiateProductionCandidate",
      "Properties": {
        "RoleName": {"Fn::Sub": "mr-lister-phase7-${EnvironmentName}-publication-dispatcher-role"},
        "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "lambda.amazonaws.com"}, "Action": "sts:AssumeRole"}]},
        "Policies": [{
          "PolicyName": "DispatchExactPublicationWork",
          "PolicyDocument": {"Version": "2012-10-17", "Statement": [
            {"Sid": "WriteDispatcherLogs", "Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": {"Fn::Sub": "${PublicationDispatcherLogGroup.Arn}:*"}},
            {"Sid": "ReadPublicationStream", "Effect": "Allow", "Action": ["dynamodb:DescribeStream", "dynamodb:GetRecords", "dynamodb:GetShardIterator"], "Resource": {"Ref": "StateTableStreamArn"}},
            {"Sid": "DiscoverPublicationStreamsInRegion", "Effect": "Allow", "Action": "dynamodb:ListStreams", "Resource": "*", "Condition": {"StringEquals": {"aws:RequestedRegion": {"Ref": "AWS::Region"}}}},
            {"Sid": "QueryOnlyDuePublicationWork", "Effect": "Allow", "Action": "dynamodb:Query", "Resource": {"Fn::Sub": "${StateTableArn}/index/DueWorkIndex"}, "Condition": {"ForAllValues:StringLike": {"dynamodb:LeadingKeys": ["PUBLICATION_WORK_DUE#0"]}}},
            {"Sid": "StartOrResolveExactPublicationExecution", "Effect": "Allow", "Action": ["states:StartExecution", "states:DescribeExecution"], "Resource": [{"Ref": "PublicationWorkflowStateMachine"}, {"Fn::Sub": "arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:execution:mr-lister-phase7-${EnvironmentName}-publication:*"}]},
            {"Sid": "SendSanitizedRecoveryEnvelope", "Effect": "Allow", "Action": "sqs:SendMessage", "Resource": {"Fn::GetAtt": ["PublicationWorkflowRecoveryQueue", "Arn"]}},
            {"Sid": "SendFailedStreamBatchToOperationsDlq", "Effect": "Allow", "Action": "sqs:SendMessage", "Resource": {"Fn::GetAtt": ["PublicationOperationsDeadLetterQueue", "Arn"]}}
          ]}
        }]
      }
    },
    "PublicationWorkerRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "InstantiateProductionCandidate",
      "Properties": {
        "RoleName": {"Fn::Sub": "mr-lister-phase7-${EnvironmentName}-publication-worker-role"},
        "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "lambda.amazonaws.com"}, "Action": "sts:AssumeRole"}]},
        "Policies": [{
          "PolicyName": "OneStepPublicationWorker",
          "PolicyDocument": {"Version": "2012-10-17", "Statement": [
            {"Sid": "WriteWorkerLogs", "Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": {"Fn::Sub": "${PublicationWorkerLogGroup.Arn}:*"}},
            {"Sid": "ReadPublicationAuthority", "Effect": "Allow", "Action": ["dynamodb:GetItem", "dynamodb:Query"], "Resource": {"Ref": "StateTableArn"}, "Condition": {"ForAllValues:StringLike": {"dynamodb:LeadingKeys": ["JOB#*", "PUBLICATION#*"]}}},
            {"Sid": "CommitPublicationConditionChecks", "Effect": "Allow", "Action": "dynamodb:ConditionCheckItem", "Resource": {"Ref": "StateTableArn"}, "Condition": {"ForAllValues:StringLike": {"dynamodb:LeadingKeys": ["JOB#*", "PUBLICATION#*"]}}},
            {"Sid": "CommitPublicationPuts", "Effect": "Allow", "Action": "dynamodb:PutItem", "Resource": {"Ref": "StateTableArn"}, "Condition": {"ForAllValues:StringLike": {"dynamodb:LeadingKeys": ["JOB#*", "PUBLICATION#*"]}, "ForAnyValue:StringEquals": {"dynamodb:EnclosingOperation": ["TransactWriteItems"]}}}
          ]}
        }]
      }
    },
    "PublicationRecoveryRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "InstantiateProductionCandidate",
      "Properties": {
        "RoleName": {"Fn::Sub": "mr-lister-phase7-${EnvironmentName}-publication-recovery-role"},
        "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "lambda.amazonaws.com"}, "Action": "sts:AssumeRole"}]},
        "Policies": [{
          "PolicyName": "SameExecutionPublicationRecovery",
          "PolicyDocument": {"Version": "2012-10-17", "Statement": [
            {"Sid": "WriteRecoveryLogs", "Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": {"Fn::Sub": "${PublicationRecoveryLogGroup.Arn}:*"}},
            {"Sid": "ConsumeRecoveryQueue", "Effect": "Allow", "Action": ["sqs:ChangeMessageVisibility", "sqs:DeleteMessage", "sqs:GetQueueAttributes", "sqs:ReceiveMessage"], "Resource": {"Fn::GetAtt": ["PublicationWorkflowRecoveryQueue", "Arn"]}},
            {"Sid": "ResolveOrRedriveSameExecution", "Effect": "Allow", "Action": ["states:DescribeExecution", "states:RedriveExecution"], "Resource": {"Fn::Sub": "arn:${AWS::Partition}:states:${AWS::Region}:${AWS::AccountId}:execution:mr-lister-phase7-${EnvironmentName}-publication:*"}},
            {"Sid": "QueryOnlyActivePublicationRecovery", "Effect": "Allow", "Action": "dynamodb:Query", "Resource": {"Fn::Sub": "${StateTableArn}/index/ExecutionRecoveryIndex"}, "Condition": {"ForAllValues:StringLike": {"dynamodb:LeadingKeys": ["PUBLICATION_WORK_RECOVERY#0"]}}},
            {"Sid": "ReadRecoveryAuthority", "Effect": "Allow", "Action": ["dynamodb:GetItem", "dynamodb:Query"], "Resource": {"Ref": "StateTableArn"}, "Condition": {"ForAllValues:StringLike": {"dynamodb:LeadingKeys": ["JOB#*", "PUBLICATION#*"]}}},
            {"Sid": "SettleRecoveryConditionChecks", "Effect": "Allow", "Action": "dynamodb:ConditionCheckItem", "Resource": {"Ref": "StateTableArn"}, "Condition": {"ForAllValues:StringLike": {"dynamodb:LeadingKeys": ["JOB#*", "PUBLICATION#*"]}}},
            {"Sid": "SettleRecoveryPuts", "Effect": "Allow", "Action": "dynamodb:PutItem", "Resource": {"Ref": "StateTableArn"}, "Condition": {"ForAllValues:StringLike": {"dynamodb:LeadingKeys": ["JOB#*", "PUBLICATION#*"]}, "ForAnyValue:StringEquals": {"dynamodb:EnclosingOperation": ["TransactWriteItems"]}}}
          ]}
        }]
      }
    },
    "PublicationRetentionRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "InstantiateProductionCandidate",
      "Properties": {
        "RoleName": {"Fn::Sub": "mr-lister-phase7-${EnvironmentName}-publication-retention-role"},
        "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "lambda.amazonaws.com"}, "Action": "sts:AssumeRole"}]},
        "Policies": [{
          "PolicyName": "TerminalPublicationRetention",
          "PolicyDocument": {"Version": "2012-10-17", "Statement": [
            {"Sid": "WriteRetentionLogs", "Effect": "Allow", "Action": ["logs:CreateLogStream", "logs:PutLogEvents"], "Resource": {"Fn::Sub": "${PublicationRetentionLogGroup.Arn}:*"}},
            {"Sid": "ReadTerminalPublicationStream", "Effect": "Allow", "Action": ["dynamodb:DescribeStream", "dynamodb:GetRecords", "dynamodb:GetShardIterator"], "Resource": {"Ref": "StateTableStreamArn"}},
            {"Sid": "DiscoverPublicationStreamsInRegion", "Effect": "Allow", "Action": "dynamodb:ListStreams", "Resource": "*", "Condition": {"StringEquals": {"aws:RequestedRegion": {"Ref": "AWS::Region"}}}},
            {"Sid": "ReadTerminalPublicationGraph", "Effect": "Allow", "Action": ["dynamodb:GetItem", "dynamodb:Query"], "Resource": {"Ref": "StateTableArn"}, "Condition": {"ForAllValues:StringLike": {"dynamodb:LeadingKeys": ["JOB#*", "OWNER#*", "PUBLICATION#*"]}}},
            {"Sid": "CommitTerminalRetention", "Effect": "Allow", "Action": ["dynamodb:ConditionCheckItem", "dynamodb:PutItem"], "Resource": {"Ref": "StateTableArn"}, "Condition": {"ForAllValues:StringLike": {"dynamodb:LeadingKeys": ["JOB#*", "OWNER#*", "PUBLICATION#*"]}, "ForAnyValue:StringEquals": {"dynamodb:EnclosingOperation": ["TransactWriteItems"]}}},
            {"Sid": "SendFailedRetentionBatchToOperationsDlq", "Effect": "Allow", "Action": "sqs:SendMessage", "Resource": {"Fn::GetAtt": ["PublicationOperationsDeadLetterQueue", "Arn"]}}
          ]}
        }]
      }
    },
    "PublicationWorkflowRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "InstantiateProductionCandidate",
      "Properties": {
        "RoleName": {"Fn::Sub": "mr-lister-phase7-${EnvironmentName}-publication-workflow-role"},
        "AssumeRolePolicyDocument": {"Version": "2012-10-17", "Statement": [{"Effect": "Allow", "Principal": {"Service": "states.amazonaws.com"}, "Action": "sts:AssumeRole"}]},
        "Policies": [{
          "PolicyName": "InvokeOnePublicationWorker",
          "PolicyDocument": {"Version": "2012-10-17", "Statement": [
            {"Sid": "InvokeOnlyPublicationWorker", "Effect": "Allow", "Action": "lambda:InvokeFunction", "Resource": {"Fn::GetAtt": ["PublicationWorkerFunction", "Arn"]}},
            {"Sid": "DeliverPayloadFreeWorkflowLogs", "Effect": "Allow", "Action": ["logs:CreateLogDelivery", "logs:DeleteLogDelivery", "logs:DescribeLogGroups", "logs:DescribeResourcePolicies", "logs:GetLogDelivery", "logs:ListLogDeliveries", "logs:PutResourcePolicy", "logs:UpdateLogDelivery"], "Resource": "*"}
          ]}
        }]
      }
    },
    "PublicationRecoveryQueuePolicy": {
      "Type": "AWS::SQS::QueuePolicy",
      "Condition": "InstantiateProductionCandidate",
      "Properties": {
        "Queues": [{"Ref": "PublicationWorkflowRecoveryQueue"}],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{
            "Sid": "AcceptOnlySanitizedWorkflowFailure",
            "Effect": "Allow",
            "Principal": {"Service": "events.amazonaws.com"},
            "Action": "sqs:SendMessage",
            "Resource": {"Fn::GetAtt": ["PublicationWorkflowRecoveryQueue", "Arn"]},
            "Condition": {
              "StringEquals": {"aws:SourceAccount": {"Ref": "AWS::AccountId"}},
              "ArnEquals": {"aws:SourceArn": {"Fn::GetAtt": ["PublicationWorkflowFailureRule", "Arn"]}}
            }
          }]
        }
      }
    },
    "PublicationOperationsDeadLetterQueuePolicy": {
      "Type": "AWS::SQS::QueuePolicy",
      "Condition": "InstantiateProductionCandidate",
      "Properties": {
        "Queues": [{"Ref": "PublicationOperationsDeadLetterQueue"}],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{
            "Sid": "AcceptOnlyPhase7EventBridgeDeliveryFailures",
            "Effect": "Allow",
            "Principal": {"Service": "events.amazonaws.com"},
            "Action": "sqs:SendMessage",
            "Resource": {"Fn::GetAtt": ["PublicationOperationsDeadLetterQueue", "Arn"]},
            "Condition": {
              "StringEquals": {"aws:SourceAccount": {"Ref": "AWS::AccountId"}},
              "ArnEquals": {"aws:SourceArn": [
                {"Fn::GetAtt": ["PublicationDueWorkSweepRule", "Arn"]},
                {"Fn::GetAtt": ["PublicationRecoverySweepRule", "Arn"]},
                {"Fn::GetAtt": ["PublicationWorkflowFailureRule", "Arn"]}
              ]}
            }
          }]
        }
      }
    },
    "PublicationQueryFunction": {
      "Type": "AWS::Serverless::Function",
      "Condition": "InstantiateProductionCandidate",
      "DependsOn": "PublicationQueryLogGroup",
      "Properties": {
        "FunctionName": {"Fn::Sub": "mr-lister-phase7-${EnvironmentName}-publication-query"},
        "CodeUri": {"Bucket": {"Ref": "CandidateCodeS3Bucket"}, "Key": {"Fn::Sub": "phase7/candidates/${CandidateReleaseFingerprint}/production-disabled.zip"}, "Version": {"Ref": "CandidateCodeS3ObjectVersion"}},
        "Handler": "mr_lister.cloud.phase7_production_entrypoints.publication_query_handler",
        "Role": {"Fn::GetAtt": ["PublicationQueryRole", "Arn"]},
        "Timeout": 10
      }
    },
    "PublicationRequestFunction": {
      "Type": "AWS::Serverless::Function",
      "Condition": "InstantiateProductionCandidate",
      "DependsOn": "PublicationRequestLogGroup",
      "Properties": {
        "FunctionName": {"Fn::Sub": "mr-lister-phase7-${EnvironmentName}-publication-request"},
        "CodeUri": {"Bucket": {"Ref": "CandidateCodeS3Bucket"}, "Key": {"Fn::Sub": "phase7/candidates/${CandidateReleaseFingerprint}/production-disabled.zip"}, "Version": {"Ref": "CandidateCodeS3ObjectVersion"}},
        "Handler": "mr_lister.cloud.phase7_production_entrypoints.publication_request_handler",
        "Role": {"Fn::GetAtt": ["PublicationRequestRole", "Arn"]},
        "Timeout": 15
      }
    },
    "PublicationDispatcherFunction": {
      "Type": "AWS::Serverless::Function",
      "Condition": "InstantiateProductionCandidate",
      "DependsOn": "PublicationDispatcherLogGroup",
      "Properties": {
        "FunctionName": {"Fn::Sub": "mr-lister-phase7-${EnvironmentName}-publication-dispatcher"},
        "CodeUri": {"Bucket": {"Ref": "CandidateCodeS3Bucket"}, "Key": {"Fn::Sub": "phase7/candidates/${CandidateReleaseFingerprint}/production-disabled.zip"}, "Version": {"Ref": "CandidateCodeS3ObjectVersion"}},
        "Handler": "mr_lister.cloud.phase7_production_entrypoints.publication_dispatcher_handler",
        "Role": {"Fn::GetAtt": ["PublicationDispatcherRole", "Arn"]},
        "Timeout": 30
      }
    },
    "PublicationWorkerFunction": {
      "Type": "AWS::Serverless::Function",
      "Condition": "InstantiateProductionCandidate",
      "DependsOn": "PublicationWorkerLogGroup",
      "Properties": {
        "FunctionName": {"Fn::Sub": "mr-lister-phase7-${EnvironmentName}-publication-worker"},
        "CodeUri": {"Bucket": {"Ref": "CandidateCodeS3Bucket"}, "Key": {"Fn::Sub": "phase7/candidates/${CandidateReleaseFingerprint}/production-disabled.zip"}, "Version": {"Ref": "CandidateCodeS3ObjectVersion"}},
        "Handler": "mr_lister.cloud.phase7_production_entrypoints.publication_worker_handler",
        "Role": {"Fn::GetAtt": ["PublicationWorkerRole", "Arn"]},
        "Timeout": 60
      }
    },
    "PublicationRecoveryFunction": {
      "Type": "AWS::Serverless::Function",
      "Condition": "InstantiateProductionCandidate",
      "DependsOn": "PublicationRecoveryLogGroup",
      "Properties": {
        "FunctionName": {"Fn::Sub": "mr-lister-phase7-${EnvironmentName}-publication-recovery"},
        "CodeUri": {"Bucket": {"Ref": "CandidateCodeS3Bucket"}, "Key": {"Fn::Sub": "phase7/candidates/${CandidateReleaseFingerprint}/production-disabled.zip"}, "Version": {"Ref": "CandidateCodeS3ObjectVersion"}},
        "Handler": "mr_lister.cloud.phase7_production_entrypoints.publication_recovery_handler",
        "Role": {"Fn::GetAtt": ["PublicationRecoveryRole", "Arn"]},
        "Timeout": 60,
        "Events": {
          "RecoveryQueue": {
            "Type": "SQS",
            "Properties": {
              "Queue": {"Fn::GetAtt": ["PublicationWorkflowRecoveryQueue", "Arn"]},
              "BatchSize": 1,
              "Enabled": false,
              "FunctionResponseTypes": ["ReportBatchItemFailures"]
            }
          }
        }
      }
    },
    "PublicationRetentionFunction": {
      "Type": "AWS::Serverless::Function",
      "Condition": "InstantiateProductionCandidate",
      "DependsOn": "PublicationRetentionLogGroup",
      "Properties": {
        "FunctionName": {"Fn::Sub": "mr-lister-phase7-${EnvironmentName}-publication-retention"},
        "CodeUri": {"Bucket": {"Ref": "CandidateCodeS3Bucket"}, "Key": {"Fn::Sub": "phase7/candidates/${CandidateReleaseFingerprint}/production-disabled.zip"}, "Version": {"Ref": "CandidateCodeS3ObjectVersion"}},
        "Handler": "mr_lister.cloud.phase7_production_entrypoints.publication_retention_handler",
        "Role": {"Fn::GetAtt": ["PublicationRetentionRole", "Arn"]},
        "Timeout": 60
      }
