{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Two-stage root-applied bootstrap for the release-bound Mr Lister Phase 6 dev core runtime UPDATE",
  "Metadata": {
    "MrListerDeployment": {
      "DeploymentClass": "CORE_RUNTIME_UPDATE_BOOTSTRAP_ONLY",
      "Environment": "dev",
      "Region": "us-west-2",
      "RootApplied": true,
      "Sequence": [
        "STAGE_A_UPLOAD_AND_FREEZE",
        "STAGE_B_EXACT_VERSION_DEPLOYER"
      ]
    }
  },
  "Parameters": {
    "NotAfter": {
      "Type": "String",
      "AllowedPattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "Description": "Exclusive UTC expiry for all temporary developer and deployer authority"
    },
    "ReleaseFingerprint": {
      "Type": "String",
      "AllowedPattern": "^(?!0{64}$)[a-f0-9]{64}$",
      "Description": "Exact sealed Phase 6 release fingerprint"
    },
    "LambdaArchiveSha256": {
      "Type": "String",
      "AllowedPattern": "^(?!0{64}$)[a-f0-9]{64}$",
      "Description": "Exact SHA-256 of phase6-lambda.zip"
    },
    "FoundationStackId": {
      "Type": "String",
      "AllowedPattern": "^arn:aws:cloudformation:us-west-2:[0-9]{12}:stack/mr-lister-phase6-dev/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "Description": "Exact retained foundation stack ID"
    },
    "LambdaVersionId": {
      "Type": "String",
      "Default": "PENDING",
      "AllowedPattern": "^(PENDING|[!-~]{3,1024})$",
      "Description": "PENDING in Stage A; exact immutable Lambda archive VersionId in Stage B"
    },
    "CoreTemplateVersionId": {
      "Type": "String",
      "Default": "PENDING",
      "AllowedPattern": "^(PENDING|[!-~]{3,1024})$",
      "Description": "PENDING in Stage A; exact immutable core template VersionId in Stage B"
    },
    "CoreTemplateVersionIdUrlEncoded": {
      "Type": "String",
      "Default": "PENDING",
      "AllowedPattern": "^(PENDING|(?:[A-Za-z0-9._~-]|%[0-9A-F]{2}){3,3072})$",
      "Description": "PENDING in Stage A; RFC 3986 query-encoded form of CoreTemplateVersionId in Stage B"
    },
    "TargetTemplateFingerprint": {
      "Type": "String",
      "Default": "PENDING",
      "AllowedPattern": "^(PENDING|(?!0{64}$)[a-f0-9]{64})$",
      "Description": "PENDING in Stage A; exact canonical core template SHA-256 in Stage B"
    },
    "ExactChangeSetName": {
      "Type": "String",
      "Default": "PENDING",
      "AllowedPattern": "^(PENDING|mr-lister-phase6-dev-runtime-update-[a-f0-9]{12})$",
      "Description": "PENDING in Stage A; fingerprint-derived exact change-set name in Stage B"
    }
  },
  "Rules": {
    "OnlyUsWest2": {
      "Assertions": [
        {
          "Assert": {"Fn::Equals": [{"Ref": "AWS::Region"}, "us-west-2"]},
          "AssertDescription": "This dev-only bootstrap must be created in us-west-2"
        }
      ]
    },
    "VersionsMoveTogether": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Or": [
              {
                "Fn::And": [
                  {"Fn::Equals": [{"Ref": "LambdaVersionId"}, "PENDING"]},
                  {"Fn::Equals": [{"Ref": "CoreTemplateVersionId"}, "PENDING"]},
                  {"Fn::Equals": [{"Ref": "CoreTemplateVersionIdUrlEncoded"}, "PENDING"]},
                  {"Fn::Equals": [{"Ref": "TargetTemplateFingerprint"}, "PENDING"]},
                  {"Fn::Equals": [{"Ref": "ExactChangeSetName"}, "PENDING"]}
                ]
              },
              {
                "Fn::And": [
                  {"Fn::Not": [{"Fn::Equals": [{"Ref": "LambdaVersionId"}, "PENDING"]}]},
                  {"Fn::Not": [{"Fn::Equals": [{"Ref": "CoreTemplateVersionId"}, "PENDING"]}]},
                  {"Fn::Not": [{"Fn::Equals": [{"Ref": "CoreTemplateVersionIdUrlEncoded"}, "PENDING"]}]},
                  {"Fn::Not": [{"Fn::Equals": [{"Ref": "TargetTemplateFingerprint"}, "PENDING"]}]},
                  {"Fn::Not": [{"Fn::Equals": [{"Ref": "ExactChangeSetName"}, "PENDING"]}]}
                ]
              }
            ]
          },
          "AssertDescription": "All Stage B immutable identities must replace PENDING together"
        }
      ]
    }
  },
  "Conditions": {
    "StageAUpload": {"Fn::Equals": [{"Ref": "CoreTemplateVersionId"}, "PENDING"]},
    "StageBExact": {"Fn::Not": [{"Fn::Equals": [{"Ref": "CoreTemplateVersionId"}, "PENDING"]}]}
  },
  "Resources": {
    "CoreRuntimeExecutionRole": {
      "Type": "AWS::IAM::Role",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "RoleName": "mr-lister-phase6-runtime-cfn-dev",
        "Description": "Retained core-scoped CloudFormation execution role for the Phase 6 dev runtime transition",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {"Service": "cloudformation.amazonaws.com"},
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "mr-lister-phase6-runtime-execution-dev",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "UseOnlyPhase6SamTransform",
                  "Effect": "Allow",
                  "Action": "cloudformation:CreateChangeSet",
                  "Resource": {"Fn::Sub": "arn:${AWS::Partition}:cloudformation:us-west-2:aws:transform/Serverless-2016-10-31"}
                },
                {
                  "Sid": "ManageOnlyCoreRuntimeRoles",
                  "Effect": "Allow",
                  "Action": [
                    "iam:CreateRole",
                    "iam:DeleteRole",
                    "iam:DeleteRolePolicy",
                    "iam:GetRole",
                    "iam:GetRolePolicy",
                    "iam:ListAttachedRolePolicies",
                    "iam:ListRolePolicies",
                    "iam:PutRolePolicy",
                    "iam:TagRole",
                    "iam:UntagRole",
                    "iam:UpdateAssumeRolePolicy",
                    "iam:UpdateRole"
                  ],
                  "Resource": {"Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/mr-lister-phase6-dev-*"}
                },
                {
                  "Sid": "PassOnlyCoreRuntimeRoles",
                  "Effect": "Allow",
                  "Action": "iam:PassRole",
                  "Resource": {"Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/mr-lister-phase6-dev-*"},
                  "Condition": {
                    "StringEquals": {
                      "iam:PassedToService": ["lambda.amazonaws.com", "states.amazonaws.com"]
                    }
                  }
                },
                {
                  "Sid": "ManageOnlyCoreLambdaFunctions",
                  "Effect": "Allow",
                  "Action": [
                    "lambda:AddPermission",
                    "lambda:CreateFunction",
                    "lambda:DeleteFunction",
                    "lambda:GetFunction",
                    "lambda:GetFunctionConfiguration",
                    "lambda:GetPolicy",
                    "lambda:ListTags",
                    "lambda:RemovePermission",
                    "lambda:TagResource",
                    "lambda:UntagResource",
                    "lambda:UpdateFunctionCode",
                    "lambda:UpdateFunctionConfiguration"
                  ],
                  "Resource": {"Fn::Sub": "arn:${AWS::Partition}:lambda:us-west-2:${AWS::AccountId}:function:mr-lister-phase6-dev-*"}
                },
                {
                  "Sid": "ManageOnlyCappedCoreLambdaConcurrency",
                  "Effect": "Allow",
                  "Action": [
                    "lambda:DeleteFunctionConcurrency",
                    "lambda:GetFunctionConcurrency",
                    "lambda:PutFunctionConcurrency"
                  ],
                  "Resource": [
                    {"Fn::Sub": "arn:${AWS::Partition}:lambda:us-west-2:${AWS::AccountId}:function:mr-lister-phase6-dev-execution-recovery"},
                    {"Fn::Sub": "arn:${AWS::Partition}:lambda:us-west-2:${AWS::AccountId}:function:mr-lister-phase6-dev-source-retention"},
                    {"Fn::Sub": "arn:${AWS::Partition}:lambda:us-west-2:${AWS::AccountId}:function:mr-lister-phase6-dev-terminal-cleanup"}
                  ]
                },
                {
                  "Sid": "CreateOnlyDispatcherEventSourceMapping",
                  "Effect": "Allow",
                  "Action": "lambda:CreateEventSourceMapping",
                  "Resource": "*",
                  "Condition": {
                    "ArnEquals": {
                      "lambda:FunctionArn": {
                        "Fn::Sub": "arn:${AWS::Partition}:lambda:us-west-2:${AWS::AccountId}:function:mr-lister-phase6-dev-dispatcher"
                      }
                    },
                    "StringEquals": {"aws:RequestedRegion": "us-west-2"}
                  }
                },
                {
                  "Sid": "ManageOnlyDispatcherEventSourceMapping",
                  "Effect": "Allow",
                  "Action": [
                    "lambda:DeleteEventSourceMapping",
                    "lambda:GetEventSourceMapping",
                    "lambda:UpdateEventSourceMapping"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:lambda:us-west-2:${AWS::AccountId}:event-source-mapping:*"
                  },
                  "Condition": {
                    "ArnEquals": {
                      "lambda:FunctionArn": {
                        "Fn::Sub": "arn:${AWS::Partition}:lambda:us-west-2:${AWS::AccountId}:function:mr-lister-phase6-dev-dispatcher"
                      }
                    },
                    "StringEquals": {"aws:RequestedRegion": "us-west-2"}
                  }
                },
                {
                  "Sid": "TagOnlyCoreEventSourceMappings",
                  "Effect": "Allow",
                  "Action": ["lambda:ListTags", "lambda:TagResource", "lambda:UntagResource"],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:lambda:us-west-2:${AWS::AccountId}:event-source-mapping:*"
                  },
                  "Condition": {"StringEquals": {"aws:RequestedRegion": "us-west-2"}}
                },
                {
                  "Sid": "ManageOnlyCoreLogGroups",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogGroup",
                    "logs:DeleteLogGroup",
                    "logs:DeleteRetentionPolicy",
                    "logs:DescribeLogStreams",
                    "logs:ListTagsForResource",
                    "logs:PutRetentionPolicy",
                    "logs:TagResource",
                    "logs:UntagResource"
                  ],
                  "Resource": [
                    {"Fn::Sub": "arn:${AWS::Partition}:logs:us-west-2:${AWS::AccountId}:log-group:/aws/lambda/mr-lister-phase6-dev-*"},
                    {"Fn::Sub": "arn:${AWS::Partition}:logs:us-west-2:${AWS::AccountId}:log-group:/aws/vendedlogs/states/mr-lister-phase6-dev-*"}
                  ]
                },
                {
                  "Sid": "ConfigureOnlyRegionalStepFunctionsLogDelivery",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogDelivery",
                    "logs:DeleteLogDelivery",
                    "logs:DescribeLogGroups",
                    "logs:DescribeResourcePolicies",
                    "logs:GetLogDelivery",
                    "logs:ListLogDeliveries",
                    "logs:PutResourcePolicy",
                    "logs:UpdateLogDelivery"
                  ],
                  "Resource": "*",
                  "Condition": {"StringEquals": {"aws:RequestedRegion": "us-west-2"}}
                },
                {
                  "Sid": "ManageOnlyCoreStateMachines",
                  "Effect": "Allow",
                  "Action": [
                    "states:CreateStateMachine",
                    "states:DeleteStateMachine",
                    "states:DescribeStateMachine",
                    "states:ListTagsForResource",
                    "states:TagResource",
                    "states:UntagResource",
                    "states:UpdateStateMachine"
                  ],
                  "Resource": {"Fn::Sub": "arn:${AWS::Partition}:states:us-west-2:${AWS::AccountId}:stateMachine:mr-lister-phase6-dev-*"}
                },
                {
                  "Sid": "ManageOnlyCoreEventRules",
                  "Effect": "Allow",
                  "Action": [
                    "events:DeleteRule",
                    "events:DescribeRule",
                    "events:ListTagsForResource",
                    "events:ListTargetsByRule",
                    "events:PutRule",
                    "events:PutTargets",
                    "events:RemoveTargets",
                    "events:TagResource",
                    "events:UntagResource"
                  ],
                  "Resource": {"Fn::Sub": "arn:${AWS::Partition}:events:us-west-2:${AWS::AccountId}:rule/mr-lister-phase6-dev-*"}
                },
                {
                  "Sid": "ManageOnlyRecoveryDeadLetterQueue",
                  "Effect": "Allow",
                  "Action": [
                    "sqs:CreateQueue",
                    "sqs:DeleteQueue",
                    "sqs:GetQueueAttributes",
                    "sqs:GetQueueUrl",
                    "sqs:ListQueueTags",
                    "sqs:SetQueueAttributes",
                    "sqs:TagQueue",
                    "sqs:UntagQueue"
                  ],
                  "Resource": {"Fn::Sub": "arn:${AWS::Partition}:sqs:us-west-2:${AWS::AccountId}:mr-lister-phase6-dev-execution-recovery-dlq"}
                },
                {
                  "Sid": "InspectAndPreserveFoundationTable",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:DescribeContinuousBackups",
                    "dynamodb:DescribeTable",
                    "dynamodb:DescribeTimeToLive",
                    "dynamodb:ListTagsOfResource",
                    "dynamodb:TagResource",
                    "dynamodb:UntagResource",
                    "dynamodb:UpdateContinuousBackups",
                    "dynamodb:UpdateTable",
                    "dynamodb:UpdateTimeToLive"
                  ],
                  "Resource": {"Fn::Sub": "arn:${AWS::Partition}:dynamodb:us-west-2:${AWS::AccountId}:table/mr-lister-phase6-dev"}
                },
                {
                  "Sid": "UpdateOnlyFoundationArtifactBucketConfiguration",
                  "Effect": "Allow",
                  "Action": [
                    "s3:DeleteBucketPolicy",
                    "s3:DeleteBucketWebsite",
                    "s3:GetBucketCORS",
                    "s3:GetBucketLocation",
                    "s3:GetBucketPolicy",
                    "s3:GetBucketTagging",
                    "s3:GetBucketVersioning",
                    "s3:GetEncryptionConfiguration",
                    "s3:GetLifecycleConfiguration",
                    "s3:GetBucketPublicAccessBlock",
                    "s3:PutBucketCORS",
                    "s3:PutBucketPolicy",
                    "s3:PutBucketTagging",
                    "s3:PutBucketVersioning",
                    "s3:PutEncryptionConfiguration",
                    "s3:PutLifecycleConfiguration",
                    "s3:PutBucketPublicAccessBlock"
                  ],
                  "Resource": {"Fn::Sub": "arn:${AWS::Partition}:s3:::mr-lister-phase6-artifacts-dev-${AWS::AccountId}-us-west-2"}
                },
                {
                  "Sid": "ReadOnlyExactLambdaDeploymentArchiveVersion",
                  "Effect": "Allow",
                  "Action": "s3:GetObjectVersion",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::mr-lister-phase6-artifacts-dev-${AWS::AccountId}-us-west-2/private/deployments/lambda/releases/${ReleaseFingerprint}/phase6-lambda-${LambdaArchiveSha256}.zip"
                  },
                  "Condition": {"StringEquals": {"s3:VersionId": {"Ref": "LambdaVersionId"}}}
                }
              ]
            }
          }
        ],
        "Tags": [
          {"Key": "DeploymentClass", "Value": "RUNTIME_CFN_EXECUTION"},
          {"Key": "Environment", "Value": "dev"},
          {"Key": "Project", "Value": "MrLister"}
        ]
      }
    },
    "DeveloperLambdaUploadPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Condition": "StageAUpload",
      "Properties": {
        "ManagedPolicyName": "mr-lister-phase6-lambda-direct-uploader-dev",
        "Description": "Expiring one-shot upload authority for only the exact Lambda archive",
        "Groups": ["mr-lister-developers"],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "ConditionallyUploadOnlyExactLambdaArchive",
              "Effect": "Allow",
              "Action": "s3:PutObject",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::mr-lister-phase6-artifacts-dev-${AWS::AccountId}-us-west-2/private/deployments/lambda/releases/${ReleaseFingerprint}/phase6-lambda-${LambdaArchiveSha256}.zip"
              },
              "Condition": {
                "DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}},
                "StringEquals": {
                  "s3:if-none-match": "*",
                  "s3:x-amz-server-side-encryption": "AES256"
                }
              }
            }
          ]
        }
      }
    },
    "DeveloperTemplateUploadPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Condition": "StageAUpload",
      "Properties": {
        "ManagedPolicyName": "mr-lister-phase6-core-template-direct-uploader-dev",
        "Description": "Expiring one-shot upload authority for only the release-bound core template",
        "Groups": ["mr-lister-developers"],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "ConditionallyUploadOnlyReleaseBoundCoreTemplate",
              "Effect": "Allow",
              "Action": "s3:PutObject",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::mr-lister-phase6-artifacts-dev-${AWS::AccountId}-us-west-2/private/deployments/cloudformation/core/releases/${ReleaseFingerprint}/core-template.json"
              },
              "Condition": {
                "DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}},
                "StringEquals": {
                  "s3:if-none-match": "*",
                  "s3:x-amz-server-side-encryption": "AES256"
                }
              }
            }
          ]
        }
      }
    },
    "DeveloperLambdaEvidenceReadbackPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "mr-lister-phase6-lambda-direct-evidence-reader-dev",
        "Description": "Expiring exact Lambda v2 readback and freeze-transition authority",
        "Groups": ["mr-lister-developers"],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "ReadBackOnlyExactLambdaReleaseObject",
              "Effect": "Allow",
              "Action": ["s3:GetObjectVersion", "s3:GetObjectVersionAttributes"],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::mr-lister-phase6-artifacts-dev-${AWS::AccountId}-us-west-2/private/deployments/lambda/releases/${ReleaseFingerprint}/phase6-lambda-${LambdaArchiveSha256}.zip"
              },
              "Condition": {"DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}}}
            },
            {
              "Sid": "ListOnlyExactLambdaReleaseObjectVersions",
              "Effect": "Allow",
              "Action": "s3:ListBucketVersions",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::mr-lister-phase6-artifacts-dev-${AWS::AccountId}-us-west-2"
              },
              "Condition": {
                "DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}},
                "StringEquals": {
                  "s3:prefix": {
                    "Fn::Sub": "private/deployments/lambda/releases/${ReleaseFingerprint}/phase6-lambda-${LambdaArchiveSha256}.zip"
                  }
                }
              }
            },
            {
              "Sid": "InspectOnlyFoundationArtifactBucket",
              "Effect": "Allow",
              "Action": [
                "s3:GetBucketLocation",
                "s3:GetBucketOwnershipControls",
                "s3:GetBucketVersioning",
                "s3:GetEncryptionConfiguration"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::mr-lister-phase6-artifacts-dev-${AWS::AccountId}-us-west-2"
              },
              "Condition": {"DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}}}
            },
            {
              "Sid": "AttachOnlyExactLambdaReleaseFreeze",
              "Effect": "Allow",
              "Action": "iam:AttachGroupPolicy",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:group/mr-lister-developers"
              },
              "Condition": {
                "DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}},
                "ArnEquals": {
                  "iam:PolicyARN": {"Ref": "DeveloperLambdaReleaseFreezePolicy"}
                }
              }
            },
            {
              "Sid": "DetachOnlyExactUploadAuthority",
              "Effect": "Allow",
              "Action": "iam:DetachGroupPolicy",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:group/mr-lister-developers"
              },
              "Condition": {
                "DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}},
                "ArnEquals": {
                  "iam:PolicyARN": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/mr-lister-phase6-lambda-direct-uploader-dev"
                  }
                }
              }
            },
            {
              "Sid": "ReadBackOnlyDeveloperPolicyAttachments",
              "Effect": "Allow",
              "Action": ["iam:GetGroup", "iam:ListAttachedGroupPolicies"],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:group/mr-lister-developers"
              },
              "Condition": {"DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}}}
            },
            {
              "Sid": "ReadBackOnlyExactLambdaFreezePolicy",
              "Effect": "Allow",
              "Action": ["iam:GetPolicy", "iam:GetPolicyVersion"],
              "Resource": {"Ref": "DeveloperLambdaReleaseFreezePolicy"},
              "Condition": {"DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}}}
            }
          ]
        }
      }
    },
    "DeveloperTemplateEvidenceReadbackPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "mr-lister-phase6-core-template-direct-evidence-reader-dev",
        "Description": "Expiring exact core-template readback, freeze-transition, and bootstrap evidence authority",
        "Groups": ["mr-lister-developers"],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "ReadBackOnlyExactCoreTemplateObject",
              "Effect": "Allow",
              "Action": ["s3:GetObjectVersion", "s3:GetObjectVersionAttributes"],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::mr-lister-phase6-artifacts-dev-${AWS::AccountId}-us-west-2/private/deployments/cloudformation/core/releases/${ReleaseFingerprint}/core-template.json"
              },
              "Condition": {"DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}}}
            },
            {
              "Sid": "ListOnlyExactCoreTemplateObjectVersions",
              "Effect": "Allow",
              "Action": "s3:ListBucketVersions",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::mr-lister-phase6-artifacts-dev-${AWS::AccountId}-us-west-2"
              },
              "Condition": {
                "DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}},
                "StringEquals": {
                  "s3:prefix": {
                    "Fn::Sub": "private/deployments/cloudformation/core/releases/${ReleaseFingerprint}/core-template.json"
                  }
                }
              }
            },
            {
              "Sid": "InspectOnlyFoundationArtifactBucketForTemplate",
              "Effect": "Allow",
              "Action": [
                "s3:GetBucketLocation",
                "s3:GetBucketOwnershipControls",
                "s3:GetBucketVersioning",
                "s3:GetEncryptionConfiguration"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::mr-lister-phase6-artifacts-dev-${AWS::AccountId}-us-west-2"
              },
              "Condition": {"DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}}}
            },
            {
              "Sid": "AttachOnlyExactCoreTemplateReleaseFreeze",
              "Effect": "Allow",
              "Action": "iam:AttachGroupPolicy",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:group/mr-lister-developers"
              },
              "Condition": {
                "DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}},
                "ArnEquals": {"iam:PolicyARN": {"Ref": "DeveloperTemplateReleaseFreezePolicy"}}
              }
            },
            {
              "Sid": "DetachOnlyExactCoreTemplateUploadAuthority",
              "Effect": "Allow",
              "Action": "iam:DetachGroupPolicy",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:group/mr-lister-developers"
              },
              "Condition": {
                "DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}},
                "ArnEquals": {
                  "iam:PolicyARN": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/mr-lister-phase6-core-template-direct-uploader-dev"
                  }
                }
              }
            },
            {
              "Sid": "ReadBackOnlyDeveloperTemplatePolicyAttachments",
              "Effect": "Allow",
              "Action": "iam:ListAttachedGroupPolicies",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:group/mr-lister-developers"
              },
              "Condition": {"DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}}}
            },
            {
              "Sid": "ReadBackOnlyExactCoreTemplateFreezePolicy",
              "Effect": "Allow",
              "Action": ["iam:GetPolicy", "iam:GetPolicyVersion"],
              "Resource": {"Ref": "DeveloperTemplateReleaseFreezePolicy"},
              "Condition": {"DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}}}
            },
            {
              "Sid": "ReadBackOnlyCoreExecutionAndDeployerRoles",
              "Effect": "Allow",
              "Action": [
                "iam:GetRole",
                "iam:GetRolePolicy",
                "iam:ListAttachedRolePolicies",
                "iam:ListRolePolicies"
              ],
              "Resource": [
                {"Fn::GetAtt": ["CoreRuntimeExecutionRole", "Arn"]},
                {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/mr-lister-phase6-runtime-update-deployer-dev"
                }
              ],
              "Condition": {"DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}}}
            },
            {
              "Sid": "ReadBackOnlyFoundationStack",
              "Effect": "Allow",
              "Action": ["cloudformation:DescribeStacks", "cloudformation:ListStackResources"],
              "Resource": {"Ref": "FoundationStackId"},
              "Condition": {"DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}}}
            }
          ]
        }
      }
    },
    "DeveloperLambdaReleaseFreezePolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "ManagedPolicyName": "mr-lister-phase6-lambda-release-freeze-dev",
        "Description": "Retained explicit deny for every write or delete of the exact sealed Lambda release object",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "FreezeExactPhase6ReleaseObject",
              "Effect": "Deny",
              "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion", "s3:PutObject"],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::mr-lister-phase6-artifacts-dev-${AWS::AccountId}-us-west-2/private/deployments/lambda/releases/${ReleaseFingerprint}/phase6-lambda-${LambdaArchiveSha256}.zip"
              }
            }
          ]
        }
      }
    },
    "DeveloperTemplateReleaseFreezePolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "ManagedPolicyName": "mr-lister-phase6-core-template-release-freeze-dev",
        "Description": "Retained explicit deny for every write or delete of the release-bound core template object",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "FreezeExactCoreTemplateObject",
              "Effect": "Deny",
              "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion", "s3:PutObject"],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::mr-lister-phase6-artifacts-dev-${AWS::AccountId}-us-west-2/private/deployments/cloudformation/core/releases/${ReleaseFingerprint}/core-template.json"
              }
            }
          ]
        }
      }
    },
    "RuntimeUpdateDeployerRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "StageBExact",
      "Properties": {
        "RoleName": "mr-lister-phase6-runtime-update-deployer-dev",
        "Description": "Expiring isolated caller for one exact reviewed Phase 6 core UPDATE change set",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": {"Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:user/mr-lister-dev"}
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "mr-lister-phase6-runtime-update-deployer-dev",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "CreateExactReviewedRuntimeUpdate",
                  "Effect": "Allow",
                  "Action": "cloudformation:CreateChangeSet",
                  "Resource": [
                    {"Ref": "FoundationStackId"},
                    {"Fn::Sub": "arn:${AWS::Partition}:cloudformation:us-west-2:aws:transform/Serverless-2016-10-31"}
                  ],
                  "Condition": {
                    "DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}},
                    "ForAllValues:StringEquals": {
                      "aws:TagKeys": ["DeploymentClass", "Environment", "Project"]
                    },
                    "StringEquals": {
                      "aws:RequestTag/DeploymentClass": "RUNTIME_UPDATE",
                      "aws:RequestTag/Environment": "dev",
                      "aws:RequestTag/Project": "MrLister",
                      "cloudformation:ChangeSetName": {"Ref": "ExactChangeSetName"},
                      "cloudformation:RoleArn": {"Fn::GetAtt": ["CoreRuntimeExecutionRole", "Arn"]},
                      "cloudformation:TemplateUrl": {
                        "Fn::Sub": "https://mr-lister-phase6-artifacts-dev-${AWS::AccountId}-us-west-2.s3.us-west-2.amazonaws.com/private/deployments/cloudformation/core/releases/${ReleaseFingerprint}/core-template.json?versionId=${CoreTemplateVersionIdUrlEncoded}"
                      }
                    }
                  }
                },
                {
                  "Sid": "PassExactRuntimeExecutionRole",
                  "Effect": "Allow",
                  "Action": "iam:PassRole",
                  "Resource": {"Fn::GetAtt": ["CoreRuntimeExecutionRole", "Arn"]},
                  "Condition": {
                    "DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}},
                    "StringEquals": {"iam:PassedToService": "cloudformation.amazonaws.com"}
                  }
                },
                {
                  "Sid": "ReadOnlyExactReviewedTemplateVersion",
                  "Effect": "Allow",
                  "Action": "s3:GetObjectVersion",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::mr-lister-phase6-artifacts-dev-${AWS::AccountId}-us-west-2/private/deployments/cloudformation/core/releases/${ReleaseFingerprint}/core-template.json"
                  },
                  "Condition": {
                    "DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}},
                    "StringEquals": {"s3:VersionId": {"Ref": "CoreTemplateVersionId"}}
                  }
                },
                {
                  "Sid": "ReadOnlyExactReviewedChangeSet",
                  "Effect": "Allow",
                  "Action": ["cloudformation:DescribeChangeSet", "cloudformation:GetTemplate"],
                  "Resource": [
                    {"Ref": "FoundationStackId"},
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:cloudformation:us-west-2:${AWS::AccountId}:changeSet/${ExactChangeSetName}/*"
                    }
                  ],
                  "Condition": {"DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}}}
                },
                {
                  "Sid": "ReadOnlyExactFoundationStack",
                  "Effect": "Allow",
                  "Action": ["cloudformation:DescribeStacks", "cloudformation:ListStackResources"],
                  "Resource": {"Ref": "FoundationStackId"},
                  "Condition": {"DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}}}
                },
                {
                  "Sid": "ReadBackOnlyExactDeploymentRoles",
                  "Effect": "Allow",
                  "Action": [
                    "iam:GetRole",
                    "iam:GetRolePolicy",
                    "iam:ListAttachedRolePolicies",
                    "iam:ListRolePolicies"
                  ],
                  "Resource": [
                    {"Fn::GetAtt": ["CoreRuntimeExecutionRole", "Arn"]},
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/mr-lister-phase6-runtime-update-deployer-dev"
                    }
                  ],
                  "Condition": {"DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}}}
                },
                {
                  "Sid": "ReadOnlyRegionalCreateEventHistory",
                  "Effect": "Allow",
                  "Action": "cloudtrail:LookupEvents",
                  "Resource": "*",
                  "Condition": {
                    "DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}},
                    "StringEquals": {"aws:RequestedRegion": "us-west-2"}
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {"Key": "DeploymentClass", "Value": "RUNTIME_UPDATE_DEPLOYER"},
          {"Key": "Environment", "Value": "dev"},
          {"Key": "ExpiresAt", "Value": {"Ref": "NotAfter"}},
          {"Key": "Project", "Value": "MrLister"}
        ]
      }
    },
    "DeveloperAssumeDeployerPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Condition": "StageBExact",
      "Properties": {
        "ManagedPolicyName": "mr-lister-phase6-assume-runtime-update-deployer-dev",
        "Description": "Expiring authority for the dev user to assume only the isolated exact-update deployer role",
        "Groups": ["mr-lister-developers"],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AssumeOnlyExactRuntimeUpdateDeployer",
              "Effect": "Allow",
              "Action": "sts:AssumeRole",
              "Resource": {"Fn::GetAtt": ["RuntimeUpdateDeployerRole", "Arn"]},
              "Condition": {"DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}}}
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "BootstrapStage": {
      "Value": {"Fn::If": ["StageBExact", "STAGE_B_EXACT_VERSION_DEPLOYER", "STAGE_A_UPLOAD_AND_FREEZE"]}
    },
    "CoreRuntimeExecutionRoleArn": {"Value": {"Fn::GetAtt": ["CoreRuntimeExecutionRole", "Arn"]}},
    "LambdaDeploymentBucket": {
      "Value": {"Fn::Sub": "mr-lister-phase6-artifacts-dev-${AWS::AccountId}-us-west-2"}
    },
    "LambdaDeploymentKey": {
      "Value": {
        "Fn::Sub": "private/deployments/lambda/releases/${ReleaseFingerprint}/phase6-lambda-${LambdaArchiveSha256}.zip"
      }
    },
    "CoreTemplateKey": {
      "Value": {
        "Fn::Sub": "private/deployments/cloudformation/core/releases/${ReleaseFingerprint}/core-template.json"
      }
    },
    "DeveloperLambdaEvidenceReadbackPolicyArn": {
      "Value": {"Ref": "DeveloperLambdaEvidenceReadbackPolicy"}
    },
    "DeveloperTemplateEvidenceReadbackPolicyArn": {
      "Value": {"Ref": "DeveloperTemplateEvidenceReadbackPolicy"}
    },
    "DeveloperLambdaReleaseFreezePolicyArn": {"Value": {"Ref": "DeveloperLambdaReleaseFreezePolicy"}},
    "DeveloperTemplateReleaseFreezePolicyArn": {"Value": {"Ref": "DeveloperTemplateReleaseFreezePolicy"}},
    "DeveloperDeploymentPolicyNotAfter": {"Value": {"Ref": "NotAfter"}},
    "TargetTemplateFingerprint": {"Value": {"Ref": "TargetTemplateFingerprint"}},
    "DefaultChangeSetExecutionAuthorization": {"Value": "BLOCKED"}
  }
}
