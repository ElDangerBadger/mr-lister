{
  "Comment": "Phase 6 bounded economics refresh execution",
  "TimeoutSeconds": 900,
  "StartAt": "ReadProviderEconomics",
  "States": {
    "ReadProviderEconomics": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ProviderDraftFunctionArn}",
        "Payload": {
          "job_id.$": "$.job_id",
          "work_request_id.$": "$.work_request_id",
          "operation": "refresh_economics"
        }
      },
      "ResultSelector": {"payload.$": "$.Payload"},
      "ResultPath": "$.worker_result",
      "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.worker_error", "Next": "SettleEconomicsFailure"}],
      "Next": "SettleEconomicsSuccess"
    },
    "SettleEconomicsSuccess": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${SettlementFunctionArn}",
        "Payload": {
          "job_id.$": "$.job_id",
          "work_request_id.$": "$.work_request_id",
          "work_type": "refresh_economics",
          "worker_result.$": "$.worker_result.payload"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [{"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2}],
      "End": true
    },
    "SettleEconomicsFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${SettlementFunctionArn}",
        "Payload": {
          "job_id.$": "$.job_id",
          "work_request_id.$": "$.work_request_id",
          "work_type": "refresh_economics",
          "worker_error_code.$": "$.worker_error.Error"
        }
      },
      "OutputPath": "$.Payload",
      "Retry": [{"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2}],
      "End": true
    }
  }
}
