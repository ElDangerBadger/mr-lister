{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "One-time, root-applied IAM bootstrap for the Mr Lister Phase 6 create-only foundation",
  "Metadata": {
    "MrListerDeployment": {
      "DeploymentClass": "FOUNDATION_BOOTSTRAP_ONLY",
      "RootApplied": true,
      "TargetStack": "mr-lister-phase6-dev"
    }
  },
  "Parameters": {
    "NotAfter": {
      "Type": "String",
      "AllowedPattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "ConstraintDescription": "must be an ISO 8601 UTC timestamp such as 2026-08-24T23:59:59Z",
      "Description": "Exclusive UTC expiry for every developer foundation-deployment permission; no default is permitted"
    }
  },
  "Resources": {
    "CloudFormationExecutionRole": {
      "Type": "AWS::IAM::Role",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "RoleName": "mr-lister-phase6-foundation-cfn-dev",
        "Description": "CloudFormation service role restricted to the retained Phase 6 dev foundation",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {"Service": "cloudformation.amazonaws.com"},
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "CreateOnlyMrListerPhase6Foundation",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ExpandOnlyTheAwsServerlessTransform",
                  "Effect": "Allow",
                  "Action": "cloudformation:CreateChangeSet",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudformation:us-west-2:aws:transform/Serverless-2016-10-31"
                  }
                },
                {
                  "Sid": "CreateConfigureAndRollbackOnlyTheFoundationTable",
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:CreateTable",
                    "dynamodb:DeleteTable",
                    "dynamodb:DescribeContinuousBackups",
                    "dynamodb:DescribeTable",
                    "dynamodb:DescribeTimeToLive",
                    "dynamodb:ListTagsOfResource",
                    "dynamodb:TagResource",
                    "dynamodb:UntagResource",
                    "dynamodb:UpdateContinuousBackups",
                    "dynamodb:UpdateTimeToLive"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:us-west-2:${AWS::AccountId}:table/mr-lister-phase6-dev"
                  }
                },
                {
                  "Sid": "TagOnlyTheFoundationTableStream",
                  "Effect": "Allow",
                  "Action": "dynamodb:TagResource",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:us-west-2:${AWS::AccountId}:table/mr-lister-phase6-dev/stream/*"
                  }
                },
                {
                  "Sid": "CreateOnlyTheFoundationBucketInUsWest2",
                  "Effect": "Allow",
                  "Action": "s3:CreateBucket",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::mr-lister-phase6-artifacts-dev-${AWS::AccountId}-us-west-2"
                  },
                  "Condition": {
                    "StringEquals": {"s3:LocationConstraint": "us-west-2"}
                  }
                },
                {
                  "Sid": "ConfigureAndRollbackOnlyTheFoundationBucket",
                  "Effect": "Allow",
                  "Action": [
                    "s3:DeleteBucket",
                    "s3:DeleteBucketPolicy",
                    "s3:GetBucketAcl",
                    "s3:GetBucketCORS",
                    "s3:GetBucketLocation",
                    "s3:GetBucketOwnershipControls",
                    "s3:GetBucketPolicy",
                    "s3:GetBucketPolicyStatus",
                    "s3:GetBucketPublicAccessBlock",
                    "s3:GetBucketTagging",
                    "s3:GetBucketVersioning",
                    "s3:GetEncryptionConfiguration",
                    "s3:GetLifecycleConfiguration",
                    "s3:ListBucket",
                    "s3:PutBucketOwnershipControls",
                    "s3:PutBucketPolicy",
                    "s3:PutBucketPublicAccessBlock",
                    "s3:PutBucketTagging",
                    "s3:PutBucketVersioning",
                    "s3:PutEncryptionConfiguration",
                    "s3:PutLifecycleConfiguration"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::mr-lister-phase6-artifacts-dev-${AWS::AccountId}-us-west-2"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {"Key": "DeploymentClass", "Value": "FOUNDATION_BOOTSTRAP_ONLY"},
          {"Key": "Environment", "Value": "dev"},
          {"Key": "Project", "Value": "MrLister"}
        ]
      }
    },
    "DeveloperDeploymentPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "mr-lister-phase6-foundation-deployer-dev",
        "Description": "Expiring create-only deployment and readback access for the exact Phase 6 dev foundation",
        "Groups": ["mr-lister-developers"],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "CreateOnlyTheReviewedFoundationChangeSet",
              "Effect": "Allow",
              "Action": "cloudformation:CreateChangeSet",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:cloudformation:us-west-2:${AWS::AccountId}:stack/mr-lister-phase6-dev/*"
              },
              "Condition": {
                "DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}},
                "StringEquals": {
                  "aws:RequestTag/DeploymentClass": "FOUNDATION_ONLY",
                  "aws:RequestTag/Environment": "dev",
                  "aws:RequestTag/Project": "MrLister",
                  "cloudformation:ChangeSetName": "mr-lister-phase6-dev-foundation-create-689897c254c9",
                  "cloudformation:RoleArn": {
                    "Fn::GetAtt": ["CloudFormationExecutionRole", "Arn"]
                  }
                },
                "ForAllValues:StringEquals": {
                  "aws:TagKeys": ["DeploymentClass", "Environment", "Project"],
                  "cloudformation:ResourceTypes": [
                    "AWS::DynamoDB::Table",
                    "AWS::S3::Bucket",
                    "AWS::S3::BucketPolicy"
                  ]
                },
                "Null": {
                  "aws:TagKeys": "false",
                  "cloudformation:ResourceTypes": "false"
                }
              }
            },
            {
              "Sid": "UseOnlyTheServerlessTransformForTheReviewedChangeSet",
              "Effect": "Allow",
              "Action": "cloudformation:CreateChangeSet",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:cloudformation:us-west-2:aws:transform/Serverless-2016-10-31"
              },
              "Condition": {
                "DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}},
                "StringEquals": {
                  "aws:RequestTag/DeploymentClass": "FOUNDATION_ONLY",
                  "aws:RequestTag/Environment": "dev",
                  "aws:RequestTag/Project": "MrLister",
                  "cloudformation:ChangeSetName": "mr-lister-phase6-dev-foundation-create-689897c254c9",
                  "cloudformation:RoleArn": {
                    "Fn::GetAtt": ["CloudFormationExecutionRole", "Arn"]
                  }
                },
                "ForAllValues:StringEquals": {
                  "aws:TagKeys": ["DeploymentClass", "Environment", "Project"],
                  "cloudformation:ResourceTypes": [
                    "AWS::DynamoDB::Table",
                    "AWS::S3::Bucket",
                    "AWS::S3::BucketPolicy"
                  ]
                },
                "Null": {
                  "aws:TagKeys": "false",
                  "cloudformation:ResourceTypes": "false"
                }
              }
            },
            {
              "Sid": "ManageOnlyTheReviewedFoundationChangeSet",
              "Effect": "Allow",
              "Action": [
                "cloudformation:DeleteChangeSet",
                "cloudformation:ExecuteChangeSet"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:cloudformation:us-west-2:${AWS::AccountId}:stack/mr-lister-phase6-dev/*"
              },
              "Condition": {
                "DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}},
                "StringEquals": {
                  "cloudformation:ChangeSetName": "mr-lister-phase6-dev-foundation-create-689897c254c9"
                }
              }
            },
            {
              "Sid": "InspectOnlyTheFoundationChangeSet",
              "Effect": "Allow",
              "Action": "cloudformation:DescribeChangeSet",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:cloudformation:us-west-2:${AWS::AccountId}:stack/mr-lister-phase6-dev/*"
              },
              "Condition": {
                "DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}}
              }
            },
            {
              "Sid": "InspectOnlyTheFoundationStack",
              "Effect": "Allow",
              "Action": [
                "cloudformation:DescribeStackEvents",
                "cloudformation:DescribeStacks",
                "cloudformation:GetTemplate",
                "cloudformation:ListStackResources"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:cloudformation:us-west-2:${AWS::AccountId}:stack/mr-lister-phase6-dev/*"
              },
              "Condition": {
                "DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}}
              }
            },
            {
              "Sid": "EnableOnlyFoundationTerminationProtection",
              "Effect": "Allow",
              "Action": "cloudformation:UpdateTerminationProtection",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:cloudformation:us-west-2:${AWS::AccountId}:stack/mr-lister-phase6-dev/*"
              },
              "Condition": {
                "DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}}
              }
            },
            {
              "Sid": "PassOnlyTheFoundationCloudFormationRole",
              "Effect": "Allow",
              "Action": "iam:PassRole",
              "Resource": {"Fn::GetAtt": ["CloudFormationExecutionRole", "Arn"]},
              "Condition": {
                "DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}},
                "StringEquals": {
                  "iam:PassedToService": "cloudformation.amazonaws.com"
                }
              }
            },
            {
              "Sid": "ReadOnlyTheFoundationTableConfiguration",
              "Effect": "Allow",
              "Action": [
                "dynamodb:DescribeContinuousBackups",
                "dynamodb:DescribeTable",
                "dynamodb:DescribeTimeToLive",
                "dynamodb:ListTagsOfResource"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:dynamodb:us-west-2:${AWS::AccountId}:table/mr-lister-phase6-dev"
              },
              "Condition": {
                "DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}}
              }
            },
            {
              "Sid": "ReadOnlyTheFoundationBucketConfiguration",
              "Effect": "Allow",
              "Action": [
                "s3:GetBucketCORS",
                "s3:GetBucketOwnershipControls",
                "s3:GetBucketPolicy",
                "s3:GetBucketPolicyStatus",
                "s3:GetBucketPublicAccessBlock",
                "s3:GetBucketTagging",
                "s3:GetBucketVersioning",
                "s3:GetEncryptionConfiguration",
                "s3:GetLifecycleConfiguration"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::mr-lister-phase6-artifacts-dev-${AWS::AccountId}-us-west-2"
              },
              "Condition": {
                "DateLessThan": {"aws:CurrentTime": {"Ref": "NotAfter"}}
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "CloudFormationExecutionRoleArn": {
      "Value": {"Fn::GetAtt": ["CloudFormationExecutionRole", "Arn"]}
    },
    "DeveloperDeploymentPolicyArn": {
      "Value": {"Ref": "DeveloperDeploymentPolicy"}
    },
    "DeveloperDeploymentPolicyNotAfter": {
      "Value": {"Ref": "NotAfter"}
    }
  }
}
