        "manifest_digest": {
          "$ref": "#/$defs/Digest"
        },
        "moderated_session": {
          "$ref": "#/$defs/ModeratedSessionEvidence"
        },
        "outcome": {
          "$ref": "#/$defs/AcceptanceOutcome"
        },
        "privacy": {
          "$ref": "#/$defs/PrivacyAttestation"
        },
        "provider_call_summary": {
          "default": null,
          "title": "Provider Call Summary",
          "type": "null"
        },
        "provider_gate_attestation": {
          "default": null,
          "title": "Provider Gate Attestation",
          "type": "null"
        },
        "recorded_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
          "title": "Recorded At",
          "type": "string"
        },
        "run_digest": {
          "$ref": "#/$defs/Digest"
        },
        "schema_version": {
          "const": "6.6.0",
