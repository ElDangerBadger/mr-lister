{
  "$comment": "Structural validation only. Every record MUST also pass the application-owned validate_phase66_evidence semantic boundary.",
  "$defs": {
    "AcceptanceOutcome": {
      "enum": [
        "passed",
        "failed",
        "inconclusive"
      ],
      "title": "AcceptanceOutcome",
      "type": "string"
    },
    "ArtifactFormat": {
      "enum": [
        "json",
        "junit_xml",
        "zip",
        "png",
        "webm"
      ],
      "title": "ArtifactFormat",
      "type": "string"
    },
    "ArtifactKind": {
      "enum": [
        "test_report",
        "browser_trace",
        "screenshot",
        "deployment_snapshot",
        "log_audit",
        "provider_call_ledger",
        "canary_summary",
        "moderated_session_record"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "AssertionEvidence": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "$ref": "#/$defs/AssertionId"
        },
        "duration_ms": {
          "anyOf": [
            {
              "maximum": 86400000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "observation_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observed_count": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Count"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "assertion_id",
        "passed"
      ],
      "title": "AssertionEvidence",
      "type": "object"
    },
    "AssertionId": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "type": "string"
    },
    "DeployedNonDestructiveEvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "actor_digests": {
          "items": {
            "$ref": "#/$defs/Digest"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Actor Digests",
          "type": "array"
        },
        "artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SanitizedArtifactEvidence"
          },
          "maxItems": 24,
          "title": "Artifacts",
          "type": "array"
        },
        "assertions": {
          "items": {
            "$ref": "#/$defs/AssertionEvidence"
          },
          "maxItems": 24,
          "minItems": 1,
          "title": "Assertions",
          "type": "array"
        },
        "correlation_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "deployment_digest": {
          "$ref": "#/$defs/Digest"
        },
        "evidence_class": {
          "const": "deployed_non_destructive",
          "title": "Evidence Class",
          "type": "string"
        },
        "gate_id": {
          "enum": [
            "deployed.edge_auth_owner_smoke",
            "deployed.upload_integrity_smoke",
            "deployed.outbox_recovery_smoke"
          ],
          "title": "Gate Id",
          "type": "string"
        },
        "job_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "manifest_digest": {
          "$ref": "#/$defs/Digest"
        },
        "moderated_session": {
          "default": null,
          "title": "Moderated Session",
          "type": "null"
        },
        "outcome": {
          "$ref": "#/$defs/AcceptanceOutcome"
        },
        "privacy": {
          "$ref": "#/$defs/PrivacyAttestation"
        },
        "provider_call_summary": {
          "default": null,
          "title": "Provider Call Summary",
          "type": "null"
        },
        "provider_gate_attestation": {
          "default": null,
          "title": "Provider Gate Attestation",
          "type": "null"
        },
        "recorded_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
          "title": "Recorded At",
          "type": "string"
        },
        "run_digest": {
          "$ref": "#/$defs/Digest"
        },
        "schema_version": {
          "const": "6.6.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_commit_digest": {
          "$ref": "#/$defs/Digest"
        },
        "work_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "schema_version",
        "manifest_digest",
        "run_digest",
        "source_commit_digest",
        "gate_id",
        "evidence_class",
        "outcome",
        "recorded_at",
        "assertions",
        "privacy",
        "deployment_digest",
        "actor_digests"
      ],
      "title": "DeployedNonDestructiveEvidenceRecord",
      "type": "object"
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ModeratedSessionEvidence": {
      "additionalProperties": false,
      "properties": {
        "completed_supported_flow": {
          "title": "Completed Supported Flow",
          "type": "boolean"
        },
        "consent_record_digest": {
          "$ref": "#/$defs/Digest"
        },
        "duration_seconds": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Duration Seconds",
          "type": "integer"
        },
        "external_documentation_used": {
          "const": false,
          "title": "External Documentation Used",
          "type": "boolean"
        },
        "first_time_seller": {
          "const": true,
          "title": "First Time Seller",
          "type": "boolean"
        },
        "operator_intervention_count": {
          "maximum": 100,
          "minimum": 0,
          "title": "Operator Intervention Count",
          "type": "integer"
        },
        "participant_digest": {
          "$ref": "#/$defs/Digest"
        },
        "session_record_digest": {
          "$ref": "#/$defs/Digest"
        },
        "task_script_digest": {
          "const": "f8ca6f9c4e6565fc9ba6f08c6094890673f8ca67d34b35c90f69cbcddd867be0",
          "title": "Task Script Digest",
          "type": "string"
        }
      },
      "required": [
        "participant_digest",
        "consent_record_digest",
        "task_script_digest",
        "session_record_digest",
        "first_time_seller",
        "external_documentation_used",
        "operator_intervention_count",
        "completed_supported_flow",
        "duration_seconds"
      ],
      "title": "ModeratedSessionEvidence",
      "type": "object"
    },
    "ModeratedUserEvidenceRecord": {
