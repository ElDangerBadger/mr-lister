        "manifest_digest",
        "run_digest",
        "source_commit_digest",
        "gate_id",
        "evidence_class",
        "outcome",
        "recorded_at",
        "assertions",
        "privacy",
        "deployment_digest",
        "actor_digests",
        "moderated_session"
      ],
      "title": "ModeratedUserEvidenceRecord",
      "type": "object"
